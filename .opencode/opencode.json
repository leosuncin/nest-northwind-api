{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [".opencode/plugins/graphify.js"],
  "mcp": {
    "mise": {
      "type": "local",
      "command": "mise",
      "args": ["mcp"],
      "environment": {
        "MISE_EXPERIMENTAL": "1"
      },
      "enabled": true
    },
    "gsd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server",
        "--no-prompts"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "/home/leosuncin/Workspaces/github/nest-northwind-api/.opencode/gsd-core/*": "allow"
    },
    "external_directory": {
      "/home/leosuncin/Workspaces/github/nest-northwind-api/.opencode/gsd-core/*": "allow"
    }
  }
}
