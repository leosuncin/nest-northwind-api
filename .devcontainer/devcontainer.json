{
  "name": "nest-northwind-api",
  "dockerComposeFile": ["compose.yaml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/nest-northwind-api",
  "runServices": ["sql-server"],
  "postCreateCommand": "sudo chown -R node:node /home/node/.local ; git clone --depth 1 https://github.com/powerline/fonts.git ~/fonts && ~/fonts/install.sh && rm -rf ~/fonts; wget -qO ~/.gitconfig https://gist.githubusercontent.com/leosuncin/7fb12809933571729e9ff3f6f8837fd0/raw/930532e442c6963bed4fa2d4af94e99c8fcf93db/.gitconfig ; echo 'eval $(pnpm completion zsh)\neval $(mise completion zsh)' >> ~/.zshrc ; sed -i 's/^ZSH_THEME=\"devcontainers\"$/ZSH_THEME=\"amuse\"/' ~/.zshrc",
  "postStartCommand": "mise trust --all && mise install && pnpm install",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "forwardPorts": [1433, 3000],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.6.0": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0.0.5": {
      "plugins": "git mise docker docker-compose node vscode zsh-autosuggestions zsh-syntax-highlighting pnpm-shell-completion",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-syntax-highlighting.git https://github.com/g-plane/pnpm-shell-completion.git"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": { "moby": false },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2.1.1": {
      "yqVersion": "latest"
    },
    "ghcr.io/devcontainers-extra/features/mise:1.0.0": {},
    "ghcr.io/jlaundry/devcontainer-features/mssql-odbc-driver:1.0.3": {}
  },
  "containerEnv": {
    "PNPM_HOME": "/home/node/.local/share/pnpm",
    "PNPM_CONFIG_STORE_DIR": "/home/node/.local/share/pnpm/store",
    "MISE_EXPERIMENTAL": "1",
    "MISE_AGE_STRICT": "0",
    "HK_MISE": "1",
    "MSSQL_DB": "northwind",
    "MSSQL_USER": "instnwnd",
    "MSSQL_PASSWORD": "${localEnv:MSSQL_PASSWORD}",
    "MSSQL_SA_PASSWORD": "${localEnv:MSSQL_SA_PASSWORD}"
  },
  "remoteEnv": {
    "EDITOR": "code --wait",
    "MSSQL_DB": "${containerEnv:MSSQL_DB}",
    "MSSQL_USER": "${containerEnv:MSSQL_USER}",
    "MSSQL_PASSWORD": "${containerEnv:MSSQL_PASSWORD}",
    "MSSQL_SA_PASSWORD": "${containerEnv:MSSQL_SA_PASSWORD}"
  },
  "mounts": [
    "type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/node/.ssh,readonly",
    "type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/mise/age.txt,target=/home/node/.config/mise/age.txt,consistency=cached",
    "type=cache,target=/home/node/.local/share/mise/installs",
    "type=cache,target=/home/node/.local/share/pnpm"
  ]
}
