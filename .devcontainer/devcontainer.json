{
  "name": "nest-northwind-api",
  "dockerComposeFile": ["compose.yaml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/nest-northwind-api",
  "runServices": ["sql-server"],
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "postCreateCommand": "mise trust --all && mise install --locked && mise bootstrap --yes",
  "postAttachCommand": "mise daemons start api",
  "waitFor": "postStartCommand",
  "shutdownAction": "stopCompose",
  "forwardPorts": [1433, 3000],
  "portsAttributes": {
    "1433": { "label": "SQL Server", "onAutoForward": "silent" },
    "3000": { "label": "API", "onAutoForward": "notify" }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.7.0": {
      "configureZshAsDefaultShell": true,
      "ohMyZshTheme": "amuse",
      "nonFreePackages": true
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0.0.5": {
      "plugins": "git mise docker docker-compose node vscode zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-syntax-highlighting.git"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "extensions": "nektos/gh-act,dlvhdr/gh-dash"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.2": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/ripgrep:1.0.15": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1.0.2": {},
    "ghcr.io/devcontainer-community/devcontainer-features/yq:1.0.3": {},
    "ghcr.io/jlaundry/devcontainer-features/mssql-odbc-driver:1.0.3": {},
    "ghcr.io/devcontainers-extra/features/uv-tool:1.0.0": {
      "package": "graphifyy",
      "with": "graphifyy[terraform]"
    }
  },
  "containerEnv": {
    "PNPM_HOME": "/home/dev/.local/share/mise/pnpm",
    "PNPM_CONFIG_STORE_DIR": "/home/dev/.cache/mise/pnpm-store",
    "MISE_EXPERIMENTAL": "1",
    "MISE_AGE_STRICT": "0",
    "HK_MISE": "1",
    "MSSQL_DB": "northwind",
    "MSSQL_USER": "instnwnd",
    "MSSQL_PASSWORD": "${localEnv:MSSQL_PASSWORD}",
    "MSSQL_SA_PASSWORD": "${localEnv:MSSQL_SA_PASSWORD}"
  },
  "remoteEnv": {
    "EDITOR": "code --wait",
    "MSSQL_DB": "${containerEnv:MSSQL_DB}",
    "MSSQL_USER": "${containerEnv:MSSQL_USER}",
    "MSSQL_PASSWORD": "${containerEnv:MSSQL_PASSWORD}",
    "MSSQL_SA_PASSWORD": "${containerEnv:MSSQL_SA_PASSWORD}"
  },
  "mounts": [
    "type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/dev/.ssh,readonly",
    "type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/mise/age.txt,target=/home/dev/.config/mise/age.txt,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "johnpapa.vscode-cloak",
        "bierner.comment-tagged-templates",
        "mikestead.dotenv",
        "usernamehw.errorlens",
        "yoavbls.pretty-ts-errors",
        "semanticdiff.semanticdiff",
        "vscode-icons-team.vscode-icons",
        "bruno-api-client.bruno",
        "wmaurer.change-case",
        "cucumberopen.cucumber-official",
        "docker.docker",
        "editorconfig.editorconfig",
        "mitchdenny.ecdc",
        "tamasfe.even-better-toml",
        "pomber.git-file-history",
        "github.vscode-github-actions",
        "eamodio.gitlens",
        "sburg.vscode-javascript-booster",
        "hverlin.mise-vscode",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mssql",
        "drcallaway.vscode-surround-with",
        "qcz.text-power-tools",
        "tamj0rd2.ts-quickfixes-extension",
        "orta.vscode-twoslash-queries",
        "vitest.explorer",
        "oxc.oxc-vscode"
      ],
      "settings": {
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.bracketPairColorization.enabled": true,
        "editor.smoothScrolling": true,
        "editor.cursorSmoothCaretAnimation": "on",
        "editor.fontFamily": "'FiraCode Nerd Font Mono', Calibri",
        "editor.fontLigatures": true,
        "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono', Consolas",
        "workbench.list.smoothScrolling": true,
        "explorer.compactFolders": true,
        "js/ts.tsdk.path": "node_modules/typescript/lib",
        "js/ts.tsdk.promptToUseWorkspaceVersion": true,
        "editor.codeActionsOnSave": {
          "source.addMissingImports.ts": "always",
          "source.organizeImports": "always",
          "source.format.oxc": "always",
          "source.fixAll.oxc": "always"
        },
        "oxc.lint.customization": {
          "no-unused-vars": {
            "severity": "warn",
            "autofix": false
          }
        }
      }
    },
    "zed": {
      "extensions": [
        "toml",
        "git-firefly",
        "dockerfile",
        "editorconfig",
        "oxc",
        "github-actions"
      ],
      "settings": {
        "file_types": {
          "Git Attributes": ["**/{git,.git,.git/info}/attributes"],
          "Git Config": [
            "*.gitconfig",
            "**/{git,.git,.git/modules,.git/modules/*}/config"
          ],
          "Git Ignore": ["**/{git,.git}/ignore", "**/.git/info/exclude"],
          "GitHub Actions": [
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml"
          ]
        },
        "languages": {
          "JavaScript": {
            "format_on_save": "on",
            "formatter": [
              {
                "code_action": "source.fixAll.oxc"
              }
            ]
          },
          "TypeScript": {
            "format_on_save": "on",
            "formatter": [
              {
                "code_action": "source.fixAll.oxc"
              }
            ]
          }
        }
      }
    }
  }
}
