amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping {
    ["actionlint"] = Builtins.actionlint
    ["droast"] = Builtins.droast
    ["hadolint"] = Builtins.hadolint
    ["ox_lint"] = Builtins.ox_lint
    ["prettier"] = Builtins.prettier
    ["tsc"] = Builtins.tsc
    ["zizmor"] = Builtins.zizmor
}
local graphify = new Mapping<String, Step> {
    ["graphify"] = {
        check = "git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD 2>/dev/null"
        fix = "graphify update"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["post-commit"] {
        steps = graphify
        fix = true
        stash = false
    }
    ["post-checkout"] {
        steps = graphify
        fix = true
        stash = false
    }
}
