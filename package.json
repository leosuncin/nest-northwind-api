{
  "name": "nest-northwind-api",
  "version": "2.1.0",
  "private": true,
  "description": "",
  "license": "AGPL-3.0-only",
  "author": "Jaime Leonardo Suncin Cruz",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "vitest run --project UNIT",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project E2E",
    "test:watch": "vitest",
    "typeorm": "node --require ttsc/register node_modules/typeorm/cli.js -d data-source.ts",
    "typeorm-extension": "node --require ttsc/register node_modules/typeorm-extension/bin/cli.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "@rapiq/adapter-typeorm": "^2.2.0",
    "@rapiq/codec-url": "^2.2.0",
    "@rapiq/core": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mssql": "^12.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "12.0.1",
    "@nestjs/schematics": "12.0.2",
    "@nestjs/testing": "12.0.3",
    "@suites/di.nestjs": "3.1.0",
    "@suites/doubles.vitest": "3.1.0",
    "@suites/unit": "3.1.1",
    "@testcontainers/mssqlserver": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "node-mocks-http": "1.18.1",
    "oxlint": "1.83.0",
    "pactum": "3.9.1",
    "prettier": "3.9.9",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ttsc": "0.30.2",
    "typeorm-extension": "4.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  }
}
