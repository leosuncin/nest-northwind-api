{
  "name": "nest-northwind-api",
  "version": "2.2.8",
  "private": true,
  "description": "",
  "license": "AGPL-3.0-only",
  "author": "Jaime Leonardo Suncin Cruz",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:repl": "nest start --entryFile repl",
    "test": "vitest run --project UNIT",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project E2E",
    "test:watch": "vitest",
    "typeorm": "node --require ttsc/register node_modules/typeorm/cli.js -d data-source.ts",
    "typeorm-extension": "node --require ttsc/register node_modules/typeorm-extension/bin/cli.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "12.0.3",
    "@rapiq/adapter-typeorm": "2.4.1",
    "@rapiq/codec-url": "2.4.1",
    "@rapiq/core": "2.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mssql": "12.7.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "8.0.0",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@ogs-gmbh/oxlint-presets": "1.3.0",
    "@suites/di.nestjs": "4.0.3",
    "@suites/doubles.vitest": "4.1.2",
    "@suites/unit": "4.1.2",
    "@testcontainers/mssqlserver": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "node-mocks-http": "1.18.1",
    "oxlint": "1.93.0",
    "pactum": "3.9.1",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ttsc": "0.32.0",
    "typeorm-extension": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
